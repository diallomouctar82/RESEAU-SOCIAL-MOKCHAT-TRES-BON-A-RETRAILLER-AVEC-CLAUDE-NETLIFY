{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": [
    "node_modules",
    "dist",
    // Les fonctions Edge s'exécutent sur DENO, pas dans l'application Vite :
    // elles utilisent le global `Deno` et les spécificateurs `jsr:` / `npm:`.
    // Les vérifier avec la configuration de types de l'app (Node + DOM) ne
    // pouvait produire que des faux positifs (29 sur 29 constatés) et masquait
    // les vraies erreurs dans le bruit. Elles sont vérifiées par Deno au
    // déploiement (`supabase functions deploy`), qui refuse un code invalide.
    "supabase/functions"
  ]
}