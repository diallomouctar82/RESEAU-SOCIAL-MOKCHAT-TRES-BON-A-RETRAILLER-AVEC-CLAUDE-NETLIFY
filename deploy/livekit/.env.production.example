# Copier en .env.production sur le VPS puis renseigner les vraies valeurs.
# Ne jamais committer .env.production (secrets réels) — seul ce .example l'est.

# Nom de domaine pointant (enregistrement DNS A) vers l'IP publique du VPS
# Hostinger — nécessaire pour que Caddy obtienne un certificat Let's Encrypt.
LIVEKIT_DOMAIN=live.lemondeavous.example

# Identifiants LiveKit — à générer soi-même (ne jamais réutiliser ceux d'un
# exemple). Par exemple avec openssl :
#   LIVEKIT_API_KEY="lk_$(openssl rand -hex 8)"
#   LIVEKIT_API_SECRET="$(openssl rand -hex 32)"
LIVEKIT_API_KEY=changeme_generate_a_random_key_id
LIVEKIT_API_SECRET=changeme_generate_a_long_random_secret
