{
  "id": "/messagerie",
  "name": "Messagerie MokNet",
  "short_name": "Messagerie",
  "description": "Vos conversations, appels et messages vocaux MokNet dans une application dédiée — même compte, mêmes discussions, mêmes notifications, mêmes réglages.",
