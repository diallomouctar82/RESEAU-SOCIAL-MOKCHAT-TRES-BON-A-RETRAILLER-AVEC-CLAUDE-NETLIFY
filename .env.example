# ==============================================================================
# LE MONDE À VOUS — CONFIGURATION DES CONNECTEURS IA & SERVICES SOUVERAINS
# Déploiement : Compatible GitHub Pages, Netlify, Cloud Run, Vercel
# Règle d'or : L'application démarre TOUJOURS même sans aucune clé (Mode Dégradé / Local-First).
# ==============================================================================

# --- 1. SUPABASE (Backend Cloud par Défaut : Auth, PostgreSQL, Storage & Realtime) ---
# https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- 2. GOOGLE GEMINI & CARTOGRAPHIE (Moteur Natif Multimodal) ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# --- 3. DEEPSEEK (DeepSeek V3 & R1 Reasoner — Raisonnement Haut Débit & Économique) ---
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# --- 4. ANTHROPIC CLAUDE (Claude 3.5 Sonnet / Haiku — Rédaction & Juridique Élite) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- 5. OPENAI (GPT-4o, o1, o3-mini, DALL-E) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- 6. ELEVENLABS (Synthèse Vocale Haute Fidélité HD des Experts Diallo) ---
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# --- 7. ALIBABA QWEN (Tongyi Qianwen / DashScope — 72B Multilingue Global) ---
# https://dashscope.console.aliyun.com/
QWEN_API_KEY=

# --- 8. MOONSHOT KIMI (Kimi k1.5 & k3 — Contexte Ultra-Long 128k/200k) ---
# https://platform.moonshot.cn/console/api-keys
KIMI_API_KEY=

# --- 9. KLING AI (Génération Vidéo Cinématique IA 1.5) ---
# https://klingai.com/ ou https://open.klingai.com/
KLING_API_KEY=

# --- 10. RUNWAY (RunwayML Gen-3 Alpha & Gen-2 — Studio Vidéo & Effets IA) ---
# https://app.runwayml.com/settings/api-keys
RUNWAY_API_KEY=

# --- 11. HEYGEN (Avatars Interactifs IA & Vidéos Portrayal Parlantes) ---
# https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=

# --- 12. OPENROUTER (Passerelle Unifiée Multi-Modèles 200+ LLMs) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- 13. N8N (Automatisation de Workflows & Webhooks Déclencheurs) ---
# https://n8n.io/
N8N_WEBHOOK_URL=

# --- 14. VISION SMART AI CORE (serveur uniquement : Edge Function ai-gateway) ---
# Ces variables ne doivent JAMAIS être préfixées VITE_ : le navigateur ne doit
# jamais recevoir le jeton de service AI Core.
AI_CORE_BASE_URL=https://ai-core.moknet.net
AI_CORE_PROJECT_ID=6aeffdc5-e681-4ec4-ad36-7d9d71449d66
AI_CORE_SERVICE_TOKEN=
