# ==============================================================================
# LE MONDE À VOUS — CONFIGURATION SUPABASE & ENVIRONNEMENT
# Déploiement : Compatible GitHub Pages, Netlify, Cloud Run, Vercel
# Règle d'or : L'application démarre TOUJOURS même sans aucune clé (Mode Dégradé / Local-First).
# ==============================================================================

# --- SUPABASE (Backend Cloud par Défaut : Auth, PostgreSQL, Storage & Realtime) ---
# Renseignez l'URL de votre projet Supabase et votre clé anonyme publique (anon public key) :
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- GOOGLE CLIENT (valeurs publiques, restreindre domaines et APIs) ---
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=

# --- NETLIFY FUNCTIONS UNIQUEMENT — NE JAMAIS préfixer par VITE_ ---
# Le site reste consultable sans ces secrets ; les fonctions sensibles échouent fermées.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
AI_REQUESTS_PER_MINUTE=20
